# ==============================================================================
# Axis LinkUp — Production & Local Environment Configuration Template
# Copy this file to .env.local for local development or configure in Vercel.
# NEVER COMMIT .env OR .env.local WITH REAL CREDENTIALS TO GIT.
# Verify readiness at any time via: npm run verify:prod -- --strict
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & CANONICAL URLS (Core Required)
# ------------------------------------------------------------------------------
NODE_ENV=development
# Production MUST use a public HTTPS origin (e.g., https://linkup.axiscolleges.in)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Axis LinkUp"

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE — MongoDB Atlas ap-south-1 Mumbai (Core Required)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-url>/axis_linkup?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & IDENTITY — Clerk (Core Required)
# ------------------------------------------------------------------------------
# Switch from pk_test_/sk_test_ to pk_live_/sk_live_ keys before production cutover.
# Ensure public sign-up is DISABLED in Clerk Dashboard (institutional provisioning only).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Svix signing secret from Clerk Dashboard > Webhooks (Endpoint: https://<domain>/api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=

# Customized authentication route paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 4. FILE STORAGE & CDN — Cloudinary Signed Uploads (Operational Required)
# ------------------------------------------------------------------------------
# Used for Assignments, Grievances, Service Requests, and Skill Passport proofs (max 25MB)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 5. REAL-TIME COMMUNICATION & PUSH — Ably Realtime (Operational Required)
# ------------------------------------------------------------------------------
# Powers zero-trust channel-scoped Chat, Live Notification Bell, and Emergency Takeover
ABLY_API_KEY=

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL — Resend (Operational Required)
# ------------------------------------------------------------------------------
# Powers account activation invites, OTP verification, password recovery, and broadcasts
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Axis LinkUp <notifications@axiscolleges.in>"
