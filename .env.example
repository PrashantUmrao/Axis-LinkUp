# ==============================================================================
# Axis LinkUp — Master Environment Configuration Template (.env.example)
# Copy this file to .env.local (or .env) and populate the values.
# NEVER COMMIT .env OR .env.local WITH REAL CREDENTIALS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & CANONICAL URLS
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Axis LinkUp"

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (MongoDB Atlas - AWS Mumbai ap-south-1)
# Required for Database Connection & Core Storage
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-url>/axis_linkup?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & IDENTITY (Clerk)
# Required during Authentication Integration (Part 3.x)
# ------------------------------------------------------------------------------
# Public publishable key from Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret server key (write-only publicMetadata operations)
CLERK_SECRET_KEY=
# Webhook signing secret for Svix user synchronization
CLERK_WEBHOOK_SECRET=
# Customized authentication route paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 4. FILE STORAGE & CDN (Cloudinary)
# Required for Direct Client Signed Uploads (Part 3.x)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 5. REAL-TIME COMMUNICATION & PRESENCE (Ably Realtime)
# Required for Chat & Emergency Broadcast WebSockets (Part 3.x)
# ------------------------------------------------------------------------------
ABLY_API_KEY=

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Resend)
# Required for Collegiate Broadcasts & Notifications (Part 3.x)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Axis LinkUp <notifications@axiscolleges.in>"

# ------------------------------------------------------------------------------
# 7. BACKGROUND NOTIFICATIONS (Firebase Cloud Messaging - Phase 2) [Optional]
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_FCM_VAPID_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
